# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité)

# Lus par docker-compose.yml pour créer la base et sécuriser Qdrant
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
QDRANT_API_KEY=<qdrant-api-key>

# Lu par l'application : mêmes utilisateur et mot de passe que ci-dessus
POSTGRES_URL=postgresql://<user>:<password>@localhost:5433/cours_rag

# Clé du serveur de modèles (llama-swap et vLLM ne la vérifient pas par défaut, mais elle doit être renseignée)
LLM_SERVER_API_KEY=<llm-api-key>
